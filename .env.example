# Credenciais D4Sign
USUARIO=seu_email@dominio.com
SENHA=sua_senha

# Caminhos relativos ao USERPROFILE (C:\Users\<seu_usuario>\)
# Exemplo: Chrome\chromedriver.exe  =>  C:\Users\<usuario>\Chrome\chromedriver.exe
CHROME_DRIVER=Chrome\chromedriver.exe
CHROME_BINARY=Chrome\GoogleChrome\App\Chrome-bin\chrome.exe
