# Credenciais D4Sign (obrigatório)
USUARIO=seu_email@dominio.com
SENHA=sua_senha

# Caminhos do Chrome para automação — relativos ao USERPROFILE (C:\Users\<seu_usuario>\)
# Opcional: se não informado, usa os padrões abaixo automaticamente:
#   Chrome\chromedriver.exe
#   Chrome\GoogleChrome\App\Chrome-bin\chrome.exe
# CHROME_DRIVER=Chrome\chromedriver.exe
# CHROME_BINARY=Chrome\GoogleChrome\App\Chrome-bin\chrome.exe
